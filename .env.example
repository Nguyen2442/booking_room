# Copy to .env and edit:  cp .env.example .env
# Every variable is optional for a local trial (docker compose up uses safe demo defaults).
# For a real deployment set at least the values marked REQUIRED.

# --- mode ---------------------------------------------------------------------
# demo = sample rooms/users and a login hint (trial only) · prod = no sample data, refuses example secrets
APP_PROFILE=prod
# Show demo credentials on the login page (must be false in production)
DEMO_HINT=false
# Port of the web UI (nginx) on this machine
WEB_PORT=8088

# --- secrets (REQUIRED in prod; the app refuses to start with the example values) ---
DB_USER=booking
DB_PASSWORD=change-me
# generate with: openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-48
# first administrator, created at startup if it does not exist yet
ADMIN_EMAIL=admin@your-company.com
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Administrator

# --- company settings -----------------------------------------------------------
APP_TIMEZONE=Asia/Ho_Chi_Minh
WORKDAY_START=08:00
WORKDAY_END=20:00
# only needed when the UI is served from another domain than the API (usually leave empty)
CORS_ALLOWED_ORIGINS=

# --- booking limits (defaults shown) ---------------------------------------------
# how far ahead a single booking may start (days)
MAX_ADVANCE_DAYS=30
# how far recurring bookings and room blocks may reach (days)
MAX_SERIES_DAYS=90
# upcoming bookings one person may hold inside the booking window
MAX_ACTIVE_BOOKINGS=20
# booked minutes per person per day, all rooms together (480 = 8 hours)
MAX_BOOKED_MINUTES_PER_DAY=480
# booking changes (create/edit/cancel) per person per minute
WRITES_PER_MINUTE=30
# how long a login stays valid
JWT_TTL=8h
